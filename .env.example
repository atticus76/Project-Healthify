GOOGLE_CLIENT_ID=yyyyyyyyy-xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=.token.json
# Where Google sends the browser after consent. Must be listed under
# "Authorized redirect URIs" on the OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/devices/callback

# --- Email alerts (US-04), optional ---
# Free with Gmail: turn on 2-Step Verification for the sending account, then
# create an app password at https://myaccount.google.com/apppasswords and paste
# it below (not your normal Gmail password). Use a team/throwaway account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME.
SMTP_FROM=
# Default recipient until someone saves an address on the Alerts page.
ALERT_EMAIL_TO=
# Used for the "see your alerts" link in the email.
HEALTHIFY_URL=http://localhost:3000

# --- Database (S2-04), required ---
# Supabase "Session pooler" connection string (Project -> Connect). Not the
# direct connection (IPv6 only) or the transaction pooler (port 6543).
# Ask a teammate for the real value; never commit it. Copy the host exactly
# from Connect: the aws-N part differs between projects, and a wrong one
# fails with "tenant/user ... not found". Format:
# postgresql://postgres.<project-ref>:<password>@aws-<N>-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Separate healthify-test project used only by pytest. Tests wipe its tables,
# so it must NOT be the same as DATABASE_URL. Leave blank to skip DB tests.
TEST_DATABASE_URL=
